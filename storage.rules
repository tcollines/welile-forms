rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /forms/{formId}/responses/{responseId}/{fileName} {
      // Allow upload if the payload is < 5MB
      allow write: if request.resource.size < 5 * 1024 * 1024;
      allow read: if firestore.get(/databases/(default)/documents/forms/$(formId)).data.owner_uid == request.auth.uid;
    }
  }
}
